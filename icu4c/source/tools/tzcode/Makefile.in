srcdir = @srcdir@
top_srcdir = @top_srcdir@

top_builddir = ../..

subdir = tools/tzcode

include $(top_builddir)/icudefs.mk

ifeq ($(TZDATA),)
TZDATA = $(firstword $(wildcard ./tzdata*.tar.gz) $(wildcard $(srcdir)/tzdata*.tar.gz))
endif
ifeq ($(TZCODE),)
TZCODE = $(firstword $(wildcard ./tzcode*.tar.gz) $(wildcard $(srcdir)/tzcode*.tar.gz))
endif

# Everything that is unpacked from the tzdata/tzcode tarballs, and everything
# that the tz tools generate, goes into this directory, so that the source
# directory only ever contains checked-in files. "make clean" just removes it.
#
# zic and tz2icu read and write several files by fixed name in the current
# directory, so they are run with OUTDIR as their working directory; the paths
# handed to (or compiled into) them are therefore absolute.
OUTDIR = out
OUTDIR_ABS := $(abspath $(OUTDIR))

# Zone/region mapping and metazone standard/DST offsets, generated into the ICU
# source tree by the CLDR-to-ICU conversion tool (see tools/cldr/cldr-to-icu/).
# This data is only used here, when generating zoneinfo64.txt; it is not part of
# ICU's runtime data.
ZONE_REGIONS := $(abspath $(top_srcdir)/data/tzdata/zoneRegions.txt)
METAZONE_OFFSETS := $(abspath $(top_srcdir)/data/tzdata/metazoneOffsets.txt)

# ICU-specific supplemental zones, compiled by zic alongside the tzdata.
ICUZONES := $(abspath $(srcdir)/icuzones)


PRIMARY_DATA = africa antarctica asia australasia europe northamerica southamerica
SUPPLEMENTAL_DATA = etcetera factory backward
TDATA =	$(PRIMARY_DATA) $(SUPPLEMENTAL_DATA)
# The same files, as they are unpacked into the output directory.
TDATA_FILES = $(TDATA:%=$(OUTDIR)/%)
TDATA_MARKER = $(OUTDIR)/tdatamarker

# Zone data compiled by zic, relative to OUTDIR.
TZDIR=zoneinfo

# https://man7.org/linux/man-pages/man2/symlink.2.html
CFLAGS+=-D_POSIX_C_SOURCE=200112L
CPPFLAGS+= -DTZDIR=\"$(TZDIR)\" 

VANGUARD_DIR= $(OUTDIR)/vanguard

# For TZ DB/ICU comparison
TZORIG=$(OUTDIR)/tzorig
TZORIG_TZDIR=$(TZORIG)/tzdir
TZORIG_ABS := $(abspath $(TZORIG))
TZORIG_TZDIR_ABS := $(abspath $(TZORIG_TZDIR))
TZORIG_OPTS := CFLAGS="-D_POSIX_C_SOURCE $(TZORIG_EXTRA_CFLAGS)" TZDIR=$(TZORIG_TZDIR_ABS)


## Options for building zdumps
ZDUMPOUT=$(OUTDIR_ABS)/zdumpout
ICUZDUMPOUT=$(OUTDIR_ABS)/icuzdumpout

ZDUMP_OPTS= -v -a -d $(ZDUMPOUT) -c 1902,2038 -i
ICUZDUMP_OPTS= -a -d $(ICUZDUMPOUT)

# Executables & objects
OBJECTS= zic.o localtime.o asctime.o scheck.o ialloc.o
ZICTARG=$(BINDIR)/zic$(EXEEXT)
ZICEXEC=$(TOOLBINDIR)/zic$(TOOLEXEEXT)
TZ2ICUTARG=$(BINDIR)/tz2icu$(EXEEXT)
TZ2ICUEXEC=$(TOOLBINDIR)/tz2icu$(TOOLEXEEXT)
ICUZDUMPTARG=$(BINDIR)/icuzdump$(EXEEXT)
ICUZDUMPEXEC=$(TOOLBINDIR)/icuzdump$(TOOLEXEEXT)

ifeq ($(TZDATA),)
all: 
	@echo ERROR "tzdata*.tar.gz" can\'t be found.
	@false
else
all: icu_data
endif

TZCODE_TARGETS= tzorig check-dump

ifeq ($(TZCODE),)
# we're broken.
$(TZCODE_TARGETS):
	@echo ERROR "tzcode*.tar.gz" can\'t be found.
	@false

else
ifeq ($(TZDATA),)
# we're broken.
$(TZCODE_TARGETS):
	@echo ERROR "tzdata*.tar.gz" can\'t be found.
	@false
else
tzorig: $(TZORIG)

$(TZORIG):	$(TZCODE) $(TZDATA)
	-$(RMV) $(TZORIG)
	mkdir -p $(TZORIG_TZDIR)
	gunzip -d < $(TZDATA) | ( cd $(TZORIG) ; tar xf - )
	gunzip -d < $(TZCODE) | ( cd $(TZORIG) ; tar xf - )
	for tzfile in $(TDATA) ; do \
		mv $(TZORIG)/$$tzfile $(TZORIG)/$$tzfile.bak && \
		awk -v DATAFORM=rearguard -f $(TZORIG)/ziguard.awk $(TZORIG)/$$tzfile.bak > $(TZORIG)/$$tzfile; \
	done
	-mv $(TZORIG)/zdump.c $(TZORIG)/zdump.c.orig
	cp $(srcdir)/zdump.c $(TZORIG)/zdump.c
	-mv $(TZORIG)/factory $(TZORIG)/factory.orig
	cat $(TZORIG)/factory.orig $(srcdir)/icuzones > $(TZORIG)/factory
	-mv $(TZORIG)/zishrink.awk $(TZORIG)/zishrink.awk.orig
	sed -e '/if (line ~ \/^R SystemV \/) return/s/^/#/' $(TZORIG)/zishrink.awk.orig > $(TZORIG)/zishrink.awk
#	-mv $(TZORIG)/Makefile $(TZORIG)/Makefile.orig
#	sed -e "s/^BACKWARD=.*/BACKWARD= backward pacificnew/" $(TZORIG)/Makefile.orig > $(TZORIG)/Makefile
	$(MAKE) -C $(TZORIG) $(TZORIG_OPTS) tzdir.h zdump zones

$(ZDUMPOUT): $(TZORIG)
	( cd $(TZORIG) ; ./zdump$(EXEEXT) $(ZDUMP_OPTS) )
	find $(ZDUMPOUT) -name '*--ICU' -exec sh -c 'mv "$${0}" $${0%--ICU}' {} \;

dump-out: $(ZDUMPOUT) $(ICUZDUMPOUT)

check-dump: dump-out
	diff -r $(ZDUMPOUT) $(ICUZDUMPOUT)

endif
endif

$(ICUZDUMPOUT): $(ICUZDUMPEXEC)
	-$(RMV) $(ICUZDUMPOUT)
	-mkdir -p $(ICUZDUMPOUT)
	$(INVOKE) $(ICUZDUMPEXEC) $(ICUZDUMP_OPTS)


#
# old 'tz' rules start here
#


$(ZICTARG):		$(OBJECTS) $(TDATA_FILES) $(srcdir)/tz2icu.h
		$(CC) $(CFLAGS) $(TZORIG_EXTRA_CFLAGS) $(LFLAGS) -I$(srcdir) $(OBJECTS) $(LDLIBS) -o $@

$(TZ2ICUTARG):	$(srcdir)/tz2icu.cpp $(srcdir)/tz2icu.h $(ZONE_REGIONS) $(METAZONE_OFFSETS)
		$(CXX) $(CXXFLAGS) -DICU_ZONE_REGIONS=\"$(ZONE_REGIONS)\" -DICU_METAZONE_OFFSETS=\"$(METAZONE_OFFSETS)\" -I$(srcdir) -I$(top_srcdir)/common $(srcdir)/tz2icu.cpp -o $@

$(ICUZDUMPTARG):	$(srcdir)/icuzdump.cpp
		$(LINK.cc)  -I$(srcdir) -I$(top_srcdir)/common -I$(top_srcdir)/i18n -I$(top_srcdir)/tools/toolutil -I$(top_srcdir)/io  -pedantic $(srcdir)/icuzdump.cpp $(LIBICUUC) $(LIBICUDT) $(LIBICUI18N) $(LIBICUIO) $(LIBICUTOOLUTIL) -o $@


$(TDATA_FILES): $(TDATA_MARKER)

$(TDATA_MARKER): $(TZDATA)
	mkdir -p $(VANGUARD_DIR)
	gunzip -d < $(TZDATA) | ( cd $(OUTDIR) ; tar xf - --exclude=Makefile )
	for tzfile in $(TDATA) ; do \
		mv $(OUTDIR)/$$tzfile $(VANGUARD_DIR)/$$tzfile && \
		awk -v DATAFORM=rearguard -f $(OUTDIR)/ziguard.awk $(VANGUARD_DIR)/$$tzfile > $(OUTDIR)/$$tzfile; \
	done
	touch $@

posix_only:	$(ZICEXEC) $(TDATA_FILES) $(srcdir)/icuzones
		cd $(OUTDIR) && $(abspath $(ZICEXEC)) -d $(TZDIR) -L /dev/null $(TDATA) $(ICUZONES)


icu_data:	$(TZ2ICUEXEC) posix_only
		cd $(OUTDIR) && $(abspath $(TZ2ICUEXEC)) $(TZDIR) `echo $(TZDATA) | sed -e "s/.*\/tzdata//;s/\.tar\.gz$$//"`
		cd $(OUTDIR) && $(abspath $(TZ2ICUEXEC)) $(TZDIR) `echo $(TZDATA) | sed -e "s/.*\/tzdata//;s/\.tar\.gz$$//"` --old

clean:
		-rm -f core *.o *.out $(ZICTARG) $(TZ2ICUTARG) $(ICUZDUMPTARG)
		@echo ICU specific cleanup:
		-$(RMV) $(OUTDIR)

checkclean:

dataclean: clean

distclean:	dataclean clean
	-rm -f Makefile

Makefile: $(srcdir)/Makefile.in  $(top_builddir)/config.status
	cd $(top_builddir) \
	&& CONFIG_FILES=$(subdir)/$@ CONFIG_HEADERS= $(SHELL) ./config.status


